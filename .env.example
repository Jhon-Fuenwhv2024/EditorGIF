# =============================================================================
# Fotogif — variables de entorno (NO subas .env con secretos al repositorio)
# Copia este archivo a .env para desarrollo local.
# En Netlify: Site settings → Environment variables.
# =============================================================================

# URL pública del sitio (sin barra final). Usada en SEO, Open Graph, sitemap,
# links para compartir y retornos de Stripe Checkout / Customer Portal.
# Por defecto en el código: https://videogif.trainfit.cloud
VITE_SITE_URL=https://videogif.trainfit.cloud

# --- Google AdSense (opcional) ---
# Sin VITE_ADSENSE_CLIENT no se carga ningún anuncio ni script de AdSense.
# Formato típico: ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_CLIENT=
# IDs de bloque (data-ad-slot). Créalos en AdSense → Anuncios → Por unidad.
VITE_ADSENSE_SLOT_CONVERT=
VITE_ADSENSE_SLOT_RESULT=

# --- Stripe (suscripción Pro) ---
# Claves de prueba (pk_test_… / sk_test_…) o de producción (pk_live_… / sk_live_…).
# El precio lo defines TÚ en el Dashboard de Stripe; aquí solo pegas el Price ID.
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Texto opcional para mostrar junto al botón Pro (ej. "Ver precio en el checkout").
# No inventes un precio en el código: déjalo vacío o pon el texto que quieras comunicar.
VITE_PRO_PRICE_LABEL=

# --- Límites de importación por enlace (MB) ---
# Opcional; si no se definen, gratis = 35 MB y Pro = 100 MB.
VITE_FREE_MAX_MB=35
VITE_PRO_MAX_MB=100
